new file mode 100644
index 0000000..3182f90
--- /dev/null
+++ b/scripts/props_station/capsule_gear.gd
@@ -0,0 +1,163 @@
+@tool
+extends "res://scripts/props_vacuum_station/station_prop_base.gd"
+## The capsule's proper props, replacing the plain shapes: a leather heavy bag on a chain, a
+## ribbed water drum with a tap and a ladle, and the ceiling's fittings (a lamp housing with a
+## grille, a cable duct, a round vent fan) plus a gauge panel for a wall. Origin on the floor
+## (bag, drum), on the ceiling at the fitting's centre (ceiling kinds), or on the wall (gauges);
+## the front faces +Z. `length` is the lamp slot's or the duct's run along Z; for the bag it is
+## the ceiling height the chain reaches (0 = the capsule's 6.7 m).
+
+const M := {
+	leather = preload("res://materials/vacuum_station_leather.tres"),
+	cloth = preload("res://materials/vacuum_station_cloth.tres"),
+	dark = preload("res://materials/rubber.tres"),
+	iron = preload("res://materials/kit_iron.tres"),
+	rust = preload("res://materials/kitb_rust.tres"),
+	hull = preload("res://materials/vacuum_station_hull.tres"),
+	verdigris = preload("res://materials/vacuum_station_verdigris.tres"),
+	brass = preload("res://materials/brass.tres"),
+	metal = preload("res://materials/metal.tres"),
+	glass = preload("res://materials/vacuum_station_crt_black.tres"),
+	dot = preload("res://materials/vacuum_station_amber.tres"),
+}
+
+@export_enum("Heavy bag", "Water drum", "Ceiling lamp housing", "Ceiling duct", "Ceiling vent fan",
+		"Wall gauges") var kind := 0:
+	set(value):
+		kind = value
+		_rebuild()
+@export var length := 0.0:
+	set(value):
+		length = maxf(value, 0.0)
+		_rebuild()
+
+
+func _build() -> void:
+	match kind:
+		0: _bag()
+		1: _drum()
+		2: _lamp_housing()
+		3: _duct()
+		4: _vent_fan()
+		5: _gauges()
+
+
+## A chain of flat links from `top` down to `bottom`, like the kit's chain bundles.
+func _chain(top: Vector3, bottom: Vector3, link := 0.26) -> void:
+	var axis := PropMesh.along(top, bottom)
+	var links := maxi(2, int(top.distance_to(bottom) / (link * 0.75)))
+	for i in links:
+		var p := top.lerp(bottom, (i + 0.5) / links)
+		var twist := axis.basis * Basis(Vector3.UP, PI * 0.5 * (i % 2))
+		pm.box(M.iron, Vector3(0.05, link, 0.16), Transform3D(twist, p))
+
+
+## A leather bag, fatter in the middle, stitched bands, four straps up to a ring and a chain
+## to the ceiling; a dark scuff on the floor under it where feet drag.
+func _bag() -> void:
+	var top := 6.7 if length <= 0.0 else length
+	pm.cyl(M.leather, 0.23, 0.27, 0.6, at(0, 1.3, 0), 10)
+	pm.cyl(M.leather, 0.27, 0.24, 0.55, at(0, 0.725, 0), 10)
+	pm.cyl(M.dark, 0.25, 0.25, 0.08, at(0, 0.42, 0), 10)  # the bottom cap
+	for y in [0.7, 1.0, 1.3]:
+		pm.cyl(M.dark, 0.275, 0.275, 0.035, at(0, y, 0), 10)  # stitched bands
+	pm.cyl(M.dark, 0.24, 0.24, 0.08, at(0, 1.62, 0), 10)  # the top cap
+	for i in 4:
+		var a := TAU * i / 4.0 + 0.4
+		pm.stick(M.leather, Vector3(cos(a) * 0.2, 1.64, sin(a) * 0.2), Vector3(0, 1.95, 0), 0.03)
+	pm.ring(M.iron, 0.025, 0.08, Transform3D(Basis(Vector3.RIGHT, PI * 0.5), Vector3(0, 1.98, 0)), 8, 4)
+	_chain(Vector3(0, 2.1, 0), Vector3(0, top, 0))
+	pm.cyl(M.iron, 0.09, 0.09, 0.06, at(0, top - 0.03, 0), 8)  # ceiling mount
+	pm.cyl(M.dark, 0.4, 0.4, 0.012, at(0.05, 0.006, 0.1), 10)  # scuffed floor
+	fp(Vector3(0.56, 1.3, 0.56), Vector3(0, 1.1, 0))
+
+
+## A ribbed drum: hoops gone green, a tap with a tin cup under it, a ladle hooked on the rim,
+## a wet dark ring on the floor.
+func _drum() -> void:
+	pm.cyl(M.hull, 0.31, 0.31, 0.9, at(0, 0.45, 0), 12)
+	for y in [0.12, 0.45, 0.78]:
+		pm.cyl(M.verdigris, 0.33, 0.33, 0.05, at(0, y, 0), 12)  # hoops
+	for i in 12:  # ribs between the hoops
+		var a := TAU * i / 12.0
+		pm.box(M.hull, Vector3(0.03, 0.9, 0.03), at(cos(a) * 0.315, 0.45, sin(a) * 0.315, Basis(Vector3.UP, -a)))
+	pm.cyl(M.verdigris, 0.3, 0.3, 0.03, at(0, 0.915, 0), 12)  # lid
+	pm.cyl(M.dark, 0.1, 0.1, 0.04, at(0, 0.94, 0), 8)  # bung
+	pm.stick(M.brass, Vector3(0, 0.28, 0.3), Vector3(0, 0.28, 0.42), 0.025)  # the tap
+	pm.stick(M.brass, Vector3(0, 0.28, 0.42), Vector3(0, 0.2, 0.42), 0.02)
+	pm.box(M.brass, Vector3(0.06, 0.015, 0.03), at(0, 0.31, 0.4))
+	pm.cyl(M.metal, 0.05, 0.045, 0.09, at(0.0, 0.045, 0.46), 8)  # the cup under it
+	pm.stick(M.metal, Vector3(0.3, 0.93, 0.05), Vector3(0.36, 0.55, 0.1), 0.012)  # ladle
+	pm.sphere(M.metal, 0.06, 0.06, at(0.37, 0.52, 0.1), 6, 3)
+	pm.cyl(M.dark, 0.42, 0.42, 0.012, at(0.02, 0.006, 0.12), 12)  # the wet floor
+	fp(Vector3(0.68, 0.95, 0.68), Vector3(0, 0.47, 0))
+
+
+## Around a lamp slot in the ceiling (origin on the ceiling at the slot's centre, the slot
+## `length` long along Z, 0.6 wide): a hull-metal frame hanging below the ceiling, a grille of
+## bars across the slot, two conduits feeding it and a junction box.
+func _lamp_housing() -> void:
+	var l := 3.0 if length <= 0.0 else length
+	var hw := 0.42
+	var hl := l * 0.5 + 0.12
+	span(M.hull, Vector3(-hw, -0.22, -hl), Vector3(-hw + 0.1, 0.02, hl))
+	span(M.hull, Vector3(hw - 0.1, -0.22, -hl), Vector3(hw, 0.02, hl))
+	span(M.hull, Vector3(-hw, -0.22, -hl), Vector3(hw, 0.02, -hl + 0.1))
+	span(M.hull, Vector3(-hw, -0.22, hl - 0.1), Vector3(hw, 0.02, hl))
+	var bars := maxi(3, int(l / 0.45))
+	for i in bars:
+		var z: float = -l * 0.5 + l * (i + 0.5) / bars
+		pm.box(M.iron, Vector3(hw * 2 - 0.1, 0.03, 0.05), at(0, -0.2, z))
+	pm.box(M.iron, Vector3(0.2, 0.12, 0.2), at(hw + 0.2, -0.06, -hl + 0.3))  # junction box
+	pm.stick(M.iron, Vector3(hw + 0.2, -0.06, -hl + 0.4), Vector3(hw + 0.2, -0.06, hl * 0.9), 0.03)
+	pm.stick(M.iron, Vector3(hw + 0.3, -0.06, -hl + 0.3), Vector3(hw + 1.2, -0.06, -hl + 0.3), 0.03)
+	fp(Vector3.ZERO, Vector3.ZERO)
+
+
+## A square duct along the ceiling (origin on the ceiling at the run's centre, `length` long
+## along Z): the box, straps every metre, a damper box in the middle, grilles at both ends.
+func _duct() -> void:
+	var l := 4.0 if length <= 0.0 else length
+	pm.box(M.hull, Vector3(0.36, 0.3, l), at(0, -0.17, 0))
+	var straps := maxi(2, int(l / 1.0))
+	for i in straps:
+		var z: float = -l * 0.5 + l * (i + 0.5) / straps
+		pm.box(M.iron, Vector3(0.42, 0.34, 0.05), at(0, -0.17, z))
+	pm.box(M.iron, Vector3(0.44, 0.36, 0.4), at(0, -0.17, 0))
+	for e in [-1.0, 1.0]:
+		pm.box(M.dark, Vector3(0.3, 0.24, 0.02), at(0, -0.17, e * (l * 0.5 + 0.005)))
+		for i in 4:
+			pm.box(M.iron, Vector3(0.3, 0.02, 0.03), at(0, -0.07 - i * 0.065, e * (l * 0.5 + 0.015)))
+	fp(Vector3.ZERO, Vector3.ZERO)
+
+
+## A round vent in the ceiling (origin on the ceiling at its centre): a dark disc, a green-worn
+## ring, four spokes, a hub and three dark blades under it.
+func _vent_fan() -> void:
+	pm.cyl(M.dark, 0.5, 0.5, 0.02, at(0, -0.01, 0), 12)
+	pm.ring(M.verdigris, 0.46, 0.52, at(0, -0.03, 0), 12, 4)
+	for i in 4:
+		var a := TAU * i / 4.0
+		pm.box(M.iron, Vector3(0.05, 0.03, 1.0), at(0, -0.04, 0, Basis(Vector3.UP, a)))
+	pm.cyl(M.iron, 0.09, 0.09, 0.08, at(0, -0.08, 0), 8)
+	for i in 3:
+		var a := TAU * i / 3.0
+		pm.box(M.dark, Vector3(0.12, 0.02, 0.36), at(cos(a) * 0.22, -0.07, sin(a) * 0.22, Basis(Vector3.UP, -a + PI * 0.5) * Basis(Vector3.FORWARD, 0.4)))
+	fp(Vector3.ZERO, Vector3.ZERO)
+
+
+## A gauge panel on a wall (origin on the wall at its centre, facing +Z): a hull plate, three
+## round dials with needles, two pipes into the wall, one amber lamp.
+func _gauges() -> void:
+	span(M.hull, Vector3(-0.55, -0.3, 0), Vector3(0.55, 0.3, 0.06))
+	for i in 3:
+		var x := -0.33 + i * 0.33
+		pm.cyl(M.brass, 0.12, 0.12, 0.05, at(x, 0.05, 0.08, Basis(Vector3.RIGHT, PI * 0.5)), 10)
+		pm.cyl(M.glass, 0.095, 0.095, 0.02, at(x, 0.05, 0.11, Basis(Vector3.RIGHT, PI * 0.5)), 10)
+		var a := 0.6 + i * 0.9 + variant * 0.4
+		pm.stick(M.dot, Vector3(x, 0.05, 0.125), Vector3(x + cos(a) * 0.07, 0.05 + sin(a) * 0.07, 0.125), 0.012)
+	for x in [-0.4, 0.4]:
+		pm.stick(M.iron, Vector3(x, -0.3, 0.1), Vector3(x, -0.9, 0.1), 0.035)
+		pm.stick(M.iron, Vector3(x, -0.9, 0.1), Vector3(x, -0.9, 0.0), 0.035)
+	pm.box(M.dot, Vector3(0.08, 0.05, 0.03), at(0, -0.2, 0.07))
+	fp(Vector3.ZERO, Vector3.ZERO)
