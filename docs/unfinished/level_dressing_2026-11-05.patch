diff --git a/scripts/props_black_sand/beacon_light.gd b/scripts/props_black_sand/beacon_light.gd
new file mode 100644
index 0000000..ca3d242
--- /dev/null
+++ b/scripts/props_black_sand/beacon_light.gd
@@ -0,0 +1,84 @@
+@tool
+extends Node3D
+## A dull red warning beacon: a small glowing ball and an OmniLight that blink together, slowly,
+## the way a mast lamp reads through haze. For the rig masts, the support columns and the
+## ceiling crane. Origin at the ball's centre. Purely visual: no collision.
+## Period, Duty and Phase mean the same as in glow_pulse.gd's Blink, so a beacon put on a prop
+## that already has a blinking lamp (a mast, the crane) keeps time with it when both match.
+
+const PropMesh := preload("res://scripts/props/prop_mesh.gd")
+const BEACON := preload("res://materials/black_sand_beacon.tres")
+const GLOW := 2.5  ## the ball's emission when lit
+
+@export var color := Color(1.0, 0.18, 0.1):
+	set(value):
+		color = value
+		_rebuild()
+## The ball's radius in metres (0.35 reads as a dot from 60 m away).
+@export var size := 0.35:
+	set(value):
+		size = maxf(value, 0.05)
+		_rebuild()
+@export var period := 2.0
+@export_range(0.05, 0.95) var duty := 0.25  ## share of the period the beacon is lit
+@export var phase := 0.0  ## seconds, so neighbouring beacons don't blink together
+@export_range(0.0, 1.0) var low := 0.06  ## glow left between blinks
+@export var light_energy := 1.2:
+	set(value):
+		light_energy = value
+		_rebuild()
+@export var light_range := 14.0:
+	set(value):
+		light_range = value
+		_rebuild()
+
+var _mesh := MeshInstance3D.new()
+var _light := OmniLight3D.new()
+var _mat: ShaderMaterial
+var _t := 0.0
+var _lit := true
+var _build_pending := false  # waiting to be built once it is in a scene (mesh_build.gd)
+
+
+func _init() -> void:
+	add_child(_mesh, false, INTERNAL_MODE_FRONT)
+	add_child(_light, false, INTERNAL_MODE_FRONT)
+	_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	_light.shadow_enabled = false
+	_rebuild()
+
+
+func _ready() -> void:
+	_t = phase
+
+
+## Every setting calls this: the mesh is built once, when the prop is in a scene (mesh_build.gd).
+func _rebuild() -> void:
+	MeshBuild.request(self)
+
+
+func _rebuild_now() -> void:
+	_mat = BEACON.duplicate()
+	_mat.set_shader_parameter("albedo_color", Color(color.r * 0.5, color.g * 0.5, color.b * 0.5, 1.0))
+	_mat.set_shader_parameter("emission_color", color)
+	_mat.set_shader_parameter("emission_energy", GLOW)
+	var pm := PropMesh.new()
+	pm.sphere(_mat, size, size * 2.0, Transform3D(), 8, 4)
+	_mesh.mesh = pm.commit()
+	_light.light_color = color
+	_light.omni_range = light_range
+	_light.light_energy = light_energy
+	_lit = true
+
+
+func _process(delta: float) -> void:
+	if Engine.is_editor_hint() or _mat == null:
+		return
+	_t += delta
+	var lit := fposmod(_t, period) < period * duty
+	if lit == _lit:
+		return
+	_lit = lit
+	var k := 1.0 if lit else low
+	_mat.set_shader_parameter("emission_energy", GLOW * k)
+	_light.light_energy = light_energy * k
diff --git a/scripts/props_black_sand/dawn_shafts.gd b/scripts/props_black_sand/dawn_shafts.gd
new file mode 100644
index 0000000..fb219ff
--- /dev/null
+++ b/scripts/props_black_sand/dawn_shafts.gd
@@ -0,0 +1,83 @@
+extends Node3D
+## Black Sand's skylight shafts at dawn. Each light_shaft.gd node under this one (with, if you
+## like, an OmniLight child named "Pool": its pale pool on the sand) stays dark until the ceiling
+## panel over it has lit, then comes up over Fade Time seconds, far shafts first, in step with the
+## ArtificialDawn node (its delay and wave time; the panels light by z, far to near). Timed in
+## _process like the dawn, so in the big world the frozen zone holds the shafts too.
+## Each shaft also gets this level's own shaft material (black_sand_shaft.tres), which stays
+## visible further off than the kit's: the ceiling is 76 m up.
+
+const SHAFT_MATERIAL := preload("res://materials/black_sand_shaft.tres")
+
+@export var dawn: NodePath  ## the ArtificialDawn node
+@export var fade_time := 6.0
+@export var far_z := -90.0  ## the first panel row to light
+@export var near_z := 90.0  ## the last
+
+var _shafts: Array[Node3D] = []
+var _meshes: Array = []   # per shaft: [MeshInstance3D cone, MultiMeshInstance3D motes, OmniLight3D or null]
+var _targets: Array = []  # per shaft: [strength, light energy]
+var _t := 0.0
+var _delay := 2.0
+var _wave := 18.0
+var _done := false
+
+
+func _ready() -> void:
+	var dawn_node := get_node_or_null(dawn)
+	if dawn_node:
+		_delay = float(dawn_node.get("delay"))
+		_wave = float(dawn_node.get("wave_time"))
+	for child in get_children():
+		if not (child is Node3D and "strength" in child):
+			continue
+		var cone: MeshInstance3D = null
+		var motes: MultiMeshInstance3D = null
+		for inner in child.get_children(true):
+			if inner is MeshInstance3D:
+				cone = inner
+			elif inner is MultiMeshInstance3D:
+				motes = inner
+		var pool := child.get_node_or_null("Pool") as OmniLight3D
+		_shafts.append(child)
+		_meshes.append([cone, motes, pool])
+		_targets.append([float(child.strength), pool.light_energy if pool else 0.0])
+		if cone:
+			cone.material_override = SHAFT_MATERIAL
+		child.visible = false
+		_set(_shafts.size() - 1, 0.0)
+
+
+func _process(delta: float) -> void:
+	if _done:
+		return
+	_t += delta
+	var all_up := true
+	for i in _shafts.size():
+		var shaft := _shafts[i]
+		var share := clampf((shaft.position.z - far_z) / maxf(0.001, near_z - far_z), 0.0, 1.0)
+		var start := _delay + _wave * share
+		var k := clampf((_t - start) / fade_time, 0.0, 1.0)
+		if k <= 0.0:
+			all_up = false
+			continue
+		if not shaft.visible:
+			shaft.visible = true
+		_set(i, smoothstep(0.0, 1.0, k))
+		if k < 1.0:
+			all_up = false
+	if all_up:
+		_done = true
+		set_process(false)
+
+
+## The shaft's brightness as a share of its own setting, without rebuilding its mesh.
+func _set(i: int, k: float) -> void:
+	var parts: Array = _meshes[i]
+	var target: Array = _targets[i]
+	if parts[0]:
+		parts[0].set_instance_shader_parameter("strength", target[0] * k)
+	if parts[1]:
+		parts[1].set_instance_shader_parameter("strength", (0.8 + target[0]) * k)
+	if parts[2]:
+		parts[2].light_energy = target[1] * k
diff --git a/scripts/props_black_sand/sand_drift_tail.gd b/scripts/props_black_sand/sand_drift_tail.gd
new file mode 100644
index 0000000..be44aa9
--- /dev/null
+++ b/scripts/props_black_sand/sand_drift_tail.gd
@@ -0,0 +1,68 @@
+@tool
+extends Node3D
+## A drift tail: the ridge of sand the wind piles up in the lee of anything standing in the dunes,
+## tapering away downwind. A chain of low mounds of the dunes' own sand (world-mapped, so it melts
+## into them), highest at the origin, lower and narrower along local +X (Black Sand's wind blows
+## toward +X; turn the node for another wind). Origin on the sand at the prop's downwind foot.
+## Fall is how far the sand drops from the origin to the tail's end (negative: it climbs).
+## Purely visual: no collision, so it never makes a step where he walks.
+
+const PropMesh := preload("res://scripts/props/prop_mesh.gd")
+const SAND := preload("res://materials/black_sand_dunes.tres")
+
+@export var length := 8.0:
+	set(value):
+		length = maxf(value, 1.0)
+		_rebuild()
+@export var width := 3.0:
+	set(value):
+		width = maxf(value, 0.5)
+		_rebuild()
+@export var height := 1.0:
+	set(value):
+		height = maxf(value, 0.1)
+		_rebuild()
+@export var fall := 0.0:
+	set(value):
+		fall = value
+		_rebuild()
+@export var random_seed := 1:
+	set(value):
+		random_seed = value
+		_rebuild()
+## Not drawn beyond this many metres (0 = always drawn).
+@export var draw_distance := 90.0:
+	set(value):
+		draw_distance = value
+		_rebuild()
+
+var _mesh := MeshInstance3D.new()
+var _build_pending := false  # waiting to be built once it is in a scene (mesh_build.gd)
+
+
+func _init() -> void:
+	add_child(_mesh, false, INTERNAL_MODE_FRONT)
+	_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	_rebuild()
+
+
+## Every setting calls this: the mesh is built once, when the prop is in a scene (mesh_build.gd).
+func _rebuild() -> void:
+	MeshBuild.request(self)
+
+
+func _rebuild_now() -> void:
+	var pm := PropMesh.new()
+	var rng := RandomNumberGenerator.new()
+	rng.seed = random_seed
+	var n := maxi(3, int(ceil(length / 1.4)) + 1)
+	for i in n:
+		var t := float(i) / float(n - 1)
+		var h := height * pow(1.0 - t, 0.8) + 0.12
+		var w := width * (1.0 - 0.55 * t) * rng.randf_range(0.85, 1.15)
+		var step := length / float(n - 1)
+		var p := Vector3(t * length, -h * 0.45 - fall * t, rng.randf_range(-0.25, 0.25) * w)
+		var half := Vector3(step * 1.1, h, w * 0.5)
+		pm.sphere(SAND, 1.0, 2.0, Transform3D(Basis.from_scale(half), p), 10, 5)
+	_mesh.mesh = pm.commit()
+	_mesh.visibility_range_end = draw_distance
diff --git a/scripts/props_black_sand/sand_monolith.gd b/scripts/props_black_sand/sand_monolith.gd
new file mode 100644
index 0000000..d68df04
--- /dev/null
+++ b/scripts/props_black_sand/sand_monolith.gd
@@ -0,0 +1,149 @@
+@tool
+extends Node3D
+## The black monolith: a plain matte cube, tilted a little as if it settled long ago, standing on
+## a stepped concrete plinth the sand is climbing, broken chunks and grit at its foot, and one
+## thin cold light along a single vertical edge (the only line on it). A landmark in the dune
+## field, off the route. Origin on the sand at the plinth's centre. The cube and the steps get box
+## collision when the game runs (never saved in the scene). Change Random Seed for other chunks.
+
+const PropMesh := preload("res://scripts/props/prop_mesh.gd")
+const CUBE := preload("res://materials/black_sand_monolith.tres")
+const EDGE := preload("res://materials/black_sand_cold_edge.tres")
+const STEP := preload("res://materials/kitb_concrete.tres")
+const GRIT := preload("res://materials/kitb_grit.tres")
+const SAND := preload("res://materials/black_sand_dunes.tres")
+
+@export var cube_size := 6.0:
+	set(value):
+		cube_size = maxf(value, 0.5)
+		_rebuild()
+## Degrees the cube leans (about two axes at once, so no face stays level).
+@export var tilt := 7.0:
+	set(value):
+		tilt = value
+		_rebuild()
+@export_range(1, 6) var steps := 3:
+	set(value):
+		steps = value
+		_rebuild()
+@export var step_height := 0.6:
+	set(value):
+		step_height = maxf(value, 0.1)
+		_rebuild()
+## How much narrower each step is than the one under it, per side.
+@export var step_inset := 1.2:
+	set(value):
+		step_inset = maxf(value, 0.1)
+		_rebuild()
+@export var random_seed := 1:
+	set(value):
+		random_seed = value
+		_rebuild()
+@export var light_color := Color(0.75, 0.88, 1.0):
+	set(value):
+		light_color = value
+		_rebuild()
+@export var light_energy := 1.4:
+	set(value):
+		light_energy = value
+		_rebuild()
+@export var light_range := 11.0:
+	set(value):
+		light_range = value
+		_rebuild()
+@export var solid := true:
+	set(value):
+		solid = value
+		_rebuild()
+
+var _mesh := MeshInstance3D.new()
+var _light := OmniLight3D.new()
+var _body: StaticBody3D
+var _boxes: Array = []  # [size, Transform3D] pairs for the collision
+var _build_pending := false  # waiting to be built once it is in a scene (mesh_build.gd)
+
+
+func _init() -> void:
+	add_child(_mesh, false, INTERNAL_MODE_FRONT)
+	add_child(_light, false, INTERNAL_MODE_FRONT)
+	_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	_light.shadow_enabled = false
+	_rebuild()
+
+
+func _ready() -> void:
+	_collide()
+
+
+## Every setting calls this: the mesh is built once, when the prop is in a scene (mesh_build.gd).
+func _rebuild() -> void:
+	MeshBuild.request(self)
+
+
+func _rebuild_now() -> void:
+	_boxes.clear()
+	var pm := PropMesh.new()
+	var rng := RandomNumberGenerator.new()
+	rng.seed = random_seed
+	var sink := 0.4  # the lowest step is this far into the sand
+	var top := steps * step_height - sink
+	for i in steps:
+		var half := cube_size * 0.5 + step_inset * (steps - i)
+		var size := Vector3(half * 2.0, step_height, half * 2.0)
+		var xf := Transform3D(Basis(), Vector3(0, step_height * (i + 0.5) - sink, 0))
+		pm.box(STEP, size, xf)
+		_boxes.append([size, xf])
+	# The cube: leaning about X and Z at once; one low corner settles into the top step.
+	var lean := Basis(Vector3.RIGHT, deg_to_rad(tilt)) * Basis(Vector3.BACK, deg_to_rad(tilt * 0.6))
+	var cube_xf := Transform3D(lean, Vector3(0, top + cube_size * 0.5 - 0.1, 0))
+	pm.box(CUBE, Vector3.ONE * cube_size, cube_xf)
+	_boxes.append([Vector3.ONE * cube_size, cube_xf])
+	# The cold edge: a thin strip up the front-right vertical edge, a hair proud of both faces.
+	var h := cube_size * 0.5
+	pm.box(EDGE, Vector3(0.1, cube_size * 0.94, 0.1), cube_xf * Transform3D(Basis(), Vector3(h, 0, h)))
+	_light.position = cube_xf * Vector3(h + 0.7, 0.1, h + 0.7)
+	_light.light_color = light_color
+	_light.light_energy = light_energy
+	_light.omni_range = light_range
+	# Grit and chunks at the foot: dark concrete spill on the lowest step, a few blocks tumbled off.
+	var foot := cube_size * 0.5 + step_inset * steps
+	for i in 7:
+		var a := rng.randf_range(0.0, TAU)
+		var r := foot + rng.randf_range(-0.6, 1.4)
+		var p := Vector3(cos(a) * r, -0.12, sin(a) * r)
+		var w := rng.randf_range(0.9, 1.8)
+		pm.sphere(GRIT, 1.0, 2.0, Transform3D(Basis.from_scale(Vector3(w, 0.22, w * 0.7)).rotated(Vector3.UP, a), p), 8, 4)
+	for i in 6:
+		var a := rng.randf_range(0.0, TAU)
+		var r := foot + rng.randf_range(0.2, 1.6)
+		var size := Vector3(rng.randf_range(0.4, 1.0), rng.randf_range(0.3, 0.6), rng.randf_range(0.4, 0.9))
+		var turn := Basis(Vector3.UP, rng.randf_range(0.0, TAU)) * Basis(Vector3.RIGHT, rng.randf_range(-0.3, 0.3))
+		pm.box(STEP, size, Transform3D(turn, Vector3(cos(a) * r, size.y * 0.3, sin(a) * r)))
+	# Sand climbing the plinth: low mounds of the dunes' own sand against the lowest step.
+	for i in 5:
+		var a := rng.randf_range(0.0, TAU)
+		var r := foot + rng.randf_range(-1.0, 0.6)
+		var w := rng.randf_range(2.0, 3.4)
+		pm.sphere(SAND, 1.0, 2.0, Transform3D(Basis.from_scale(Vector3(w, rng.randf_range(0.35, 0.7), w * 0.8)).rotated(Vector3.UP, a),
+				Vector3(cos(a) * r, -0.25, sin(a) * r)), 10, 5)
+	_mesh.mesh = pm.commit()
+	if is_inside_tree():
+		_collide()
+
+
+## One StaticBody3D (layer 1, like the Blocks) with a box per step and one for the cube.
+func _collide() -> void:
+	if _body:
+		_body.queue_free()
+		_body = null
+	if Engine.is_editor_hint() or not solid or _boxes.is_empty():
+		return
+	_body = StaticBody3D.new()
+	add_child(_body, false, INTERNAL_MODE_FRONT)
+	for pair in _boxes:
+		var shape := BoxShape3D.new()
+		shape.size = pair[0]
+		var col := CollisionShape3D.new()
+		col.shape = shape
+		col.transform = pair[1]
+		_body.add_child(col)
diff --git a/scripts/props_massacre/blaze.gd b/scripts/props_massacre/blaze.gd
new file mode 100644
index 0000000..0ac815d
--- /dev/null
+++ b/scripts/props_massacre/blaze.gd
@@ -0,0 +1,41 @@
+extends Node3D
+## A fire of the massacre (and the festival's fire basin): the hall bonfire's flame tongues,
+## sparks and smoke (scripts/vfx/hall_fire_fx.gd) over a burning heap or a roof. Put the node
+## where the flames start (the top of the heap Block). `light` names the OmniLight3D that goes
+## with it: it flickers with the fire while the game runs. Hidden with its parent (the Raiders
+## group), so a blaze appears when the story shows them. Nothing here is saved in the scene.
+
+const FireFx := preload("res://scripts/vfx/hall_fire_fx.gd")
+const FLAME := preload("res://materials/hall_flame.tres")
+
+## Radius of the burning heap: 1 is a market stall, 2 a roof.
+@export var radius := 1.0
+## Height of the flames against the bonfire's (1 = the hall's).
+@export var size := 0.7
+@export var smoke_height := 9.0
+@export var light: NodePath
+
+var _light: OmniLight3D
+var _base := 1.0
+var _t := 0.0
+var _seed := 0.0
+
+
+func _ready() -> void:
+	var quads := FireFx.flames(self, radius, 0.0, FLAME)
+	for q in quads:
+		q.scale *= Vector3(size, size, 1.0)
+	FireFx.embers(self, radius, 0.1)
+	FireFx.smoke(self, radius, 0.2, smoke_height)
+	_light = get_node_or_null(light) as OmniLight3D
+	if _light:
+		_base = _light.light_energy
+	_seed = float(hash(name) % 100)
+
+
+func _process(delta: float) -> void:
+	if _light == null or not is_visible_in_tree():
+		return
+	_t += delta
+	var w := sin(_t * 7.3 + _seed) * 0.5 + sin(_t * 13.1 + _seed * 1.7) * 0.3 + sin(_t * 2.1) * 0.2
+	_light.light_energy = _base * (1.0 + w * 0.18)
diff --git a/scripts/props_massacre/paper_lantern.gd b/scripts/props_massacre/paper_lantern.gd
new file mode 100644
index 0000000..2d28942
--- /dev/null
+++ b/scripts/props_massacre/paper_lantern.gd
@@ -0,0 +1,161 @@
+@tool
+extends Node3D
+## A paper lantern of the Massacre's village, in place of the old glowing cubes: a ribbed paper
+## body between two dark timber caps, a cord up to the string and a tassel below, and a soft
+## ball of glow round it (materials/kit_glow.tres) so the light seems to fall off gently.
+##   Hanging round: the festival string lantern (chochin), hung from the origin.
+##   Hanging long: a taller cylinder lantern, hung from the origin.
+##   Post box: a square timber-and-paper lantern on a post (origin at the box's centre).
+##   Fallen: a round one on its side on the ground, torn and out (origin on the floor).
+## Variant picks the paper: most are warm, every third is red. Purely visual: no collision and
+## no light of its own (the strings' OmniLights stay, with lantern_glow.gd breathing them).
+## Identical lanterns share one mesh while the game runs (mesh_build.gd).
+
+const PropMesh := preload("res://scripts/props/prop_mesh.gd")
+const GLOW := preload("res://materials/kit_glow.tres")
+const M := {
+	warm = preload("res://materials/massacre_lantern_paper.tres"), red = preload("res://materials/massacre_lantern_red.tres"),
+	out = preload("res://materials/massacre_lantern_out.tres"), timber = preload("res://materials/massacre_timber.tres"),
+	cord = preload("res://materials/massacre_straw.tres"), tassel = preload("res://materials/massacre_cloth_red.tres"),
+	rib = preload("res://materials/massacre_timber_light.tres"),
+}
+
+@export_enum("Hanging round", "Hanging long", "Post box", "Fallen") var kind := 0:
+	set(value):
+		kind = value
+		_rebuild()
+@export var variant := 0:
+	set(value):
+		variant = value
+		_rebuild()
+## Size against the usual lantern (1 = a 0.5 m string lantern).
+@export var scale_factor := 1.0:
+	set(value):
+		scale_factor = maxf(value, 0.2)
+		_rebuild()
+## How wide the soft glow round the paper is (0 = none).
+@export var halo := 1.0:
+	set(value):
+		halo = maxf(value, 0.0)
+		_rebuild()
+
+var _mesh := MeshInstance3D.new()
+var _halo := MultiMeshInstance3D.new()
+var _multi := MultiMesh.new()
+var _build_pending := false  # waiting to be built once it is in a scene (mesh_build.gd)
+
+
+func _init() -> void:
+	_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	_halo.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	_multi.transform_format = MultiMesh.TRANSFORM_3D
+	_multi.use_custom_data = true
+	_halo.multimesh = _multi
+	add_child(_mesh, false, INTERNAL_MODE_FRONT)
+	add_child(_halo, false, INTERNAL_MODE_FRONT)
+	_rebuild()
+
+
+## Every setting calls this: the mesh is built once, when the lantern is in a scene (mesh_build.gd).
+func _rebuild() -> void:
+	MeshBuild.request(self)
+
+
+func _rebuild_now() -> void:
+	var key := [&"paper_lantern", kind, variant % 3, snappedf(scale_factor, 0.01)]
+	var mesh := MeshBuild.shared(key)
+	if mesh == null:
+		var pm := PropMesh.new()
+		match kind:
+			1: _long(pm)
+			2: _box(pm)
+			3: _fallen(pm)
+			_: _round(pm)
+		mesh = pm.commit()
+		MeshBuild.share(key, mesh)
+	_mesh.mesh = mesh
+	_build_halo()
+
+
+func _paper() -> Material:
+	if kind == 3:
+		return M.out
+	return M.red if variant % 3 == 2 else M.warm
+
+
+func _at(p: Vector3, b := Basis()) -> Transform3D:
+	return Transform3D(b, p * scale_factor)
+
+
+## The round festival lantern: a squashed paper ball with horizontal ribs, caps above and below.
+func _round(pm: PropMesh) -> void:
+	var k := scale_factor
+	pm.stick(M.cord, Vector3.ZERO, Vector3(0, -0.12, 0) * k, 0.012 * k)
+	pm.cyl(M.timber, 0.1 * k, 0.1 * k, 0.05 * k, _at(Vector3(0, -0.14, 0)), 8)
+	pm.sphere(_paper(), 0.24 * k, 0.4 * k, _at(Vector3(0, -0.37, 0)), 10, 5)
+	for i in 4:  # the ribs: thin dark rings round the paper
+		var y := -0.22 - i * 0.1
+		var r := 0.245 * sqrt(1.0 - pow((y + 0.37) / 0.2, 2.0) * 0.96)
+		pm.ring(M.rib, r * k, (r + 0.012) * k, _at(Vector3(0, y, 0)), 10, 3)
+	pm.cyl(M.timber, 0.1 * k, 0.1 * k, 0.05 * k, _at(Vector3(0, -0.6, 0)), 8)
+	pm.stick(M.tassel, Vector3(0, -0.62, 0) * k, Vector3(0, -0.78, 0) * k, 0.03 * k)
+
+
+## The long lantern: a paper cylinder with rings, for verandas and gates.
+func _long(pm: PropMesh) -> void:
+	var k := scale_factor
+	pm.stick(M.cord, Vector3.ZERO, Vector3(0, -0.1, 0) * k, 0.012 * k)
+	pm.cyl(M.timber, 0.15 * k, 0.15 * k, 0.05 * k, _at(Vector3(0, -0.12, 0)), 8)
+	pm.cyl(_paper(), 0.16 * k, 0.16 * k, 0.5 * k, _at(Vector3(0, -0.4, 0)), 10)
+	for i in 5:
+		pm.ring(M.rib, 0.16 * k, 0.172 * k, _at(Vector3(0, -0.2 - i * 0.1, 0)), 10, 3)
+	pm.cyl(M.timber, 0.15 * k, 0.15 * k, 0.05 * k, _at(Vector3(0, -0.68, 0)), 8)
+	pm.stick(M.tassel, Vector3(0, -0.7, 0) * k, Vector3(0, -0.86, 0) * k, 0.03 * k)
+
+
+## The post lantern: a timber frame round four paper panels, a little tiled cap on top.
+func _box(pm: PropMesh) -> void:
+	var k := scale_factor
+	var s := 0.8 * k
+	var h := 0.6 * k
+	pm.box(_paper(), Vector3(s - 0.1 * k, h - 0.08 * k, s - 0.1 * k), _at(Vector3.ZERO))
+	for sx: float in [-1.0, 1.0]:
+		for sz: float in [-1.0, 1.0]:
+			pm.box(M.timber, Vector3(0.06, h, 0.06) * k, _at(Vector3(sx * 0.37, 0, sz * 0.37)))
+	for sy: float in [-1.0, 1.0]:
+		pm.box(M.timber, Vector3(s, 0.05 * k, s), _at(Vector3(0, sy * h * 0.5, 0)))
+	pm.box(M.timber, Vector3(s + 0.3 * k, 0.06 * k, s + 0.3 * k), _at(Vector3(0, h * 0.5 + 0.08 * k, 0)))
+	pm.cyl(M.timber, 0.02 * k, (s + 0.3 * k) * 0.72, 0.16 * k, _at(Vector3(0, h * 0.5 + 0.19 * k, 0)), 4)
+	pm.box(M.timber, Vector3(0.14, 0.2, 0.14) * k, _at(Vector3(0, -h * 0.5 - 0.1 * k, 0)))
+
+
+## A lantern knocked down in the massacre: on its side, torn open, the light out.
+func _fallen(pm: PropMesh) -> void:
+	var k := scale_factor
+	var lie := Basis(Vector3.FORWARD, PI * 0.5) * Basis(Vector3.UP, 0.4)
+	pm.sphere(M.out, 0.24 * k, 0.4 * k, _at(Vector3(0, 0.2, 0), lie), 10, 5)
+	pm.cyl(M.timber, 0.1 * k, 0.1 * k, 0.05 * k, _at(Vector3(0.22, 0.2, 0), lie), 8)
+	for i in 3:
+		pm.ring(M.rib, 0.2 * k, 0.212 * k, _at(Vector3(-0.1 + i * 0.1, 0.2, 0), lie), 10, 3)
+	pm.box(M.out, Vector3(0.3, 0.02, 0.2) * k, _at(Vector3(0.35, 0.01, 0.2), Basis(Vector3.UP, 0.7)))  # a torn scrap
+
+
+func _build_halo() -> void:
+	var ball := SphereMesh.new()
+	ball.radius = 0.55 * halo * scale_factor
+	ball.height = ball.radius * 2.0
+	ball.radial_segments = 8
+	ball.rings = 4
+	_multi.instance_count = 0
+	if halo <= 0.0 or kind == 3:
+		return
+	_multi.mesh = ball
+	_multi.instance_count = 1
+	var centre := Vector3(0, -0.4 * scale_factor, 0) if kind != 2 else Vector3.ZERO
+	_multi.set_instance_transform(0, Transform3D(Basis(), centre))
+	_multi.set_instance_custom_data(0, Color(0, 0, 0, 1))
+	_halo.material_override = GLOW
+	var c := Color(1.0, 0.62, 0.3) if variant % 3 != 2 else Color(1.0, 0.3, 0.12)
+	_halo.set_instance_shader_parameter("tint", Vector3(c.r, c.g, c.b))
+	_halo.set_instance_shader_parameter("strength", 0.28)
+	_halo.custom_aabb = AABB(centre - Vector3.ONE * ball.radius, Vector3.ONE * ball.radius * 2.0)
