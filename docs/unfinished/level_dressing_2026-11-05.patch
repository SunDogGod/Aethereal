+++ b/scripts/props_station/crt_terminal.gd
@@ -0,0 +1,104 @@
+@tool
+extends "res://scripts/props_vacuum_station/station_prop_base.gd"
+## Beige CRT terminals, the station's old computers: a fat bevelled monitor shell with a dark
+## glass face showing red bar graphs (thick emissive strokes, no fine lines), a keyboard slab,
+## cables. Kinds: a desk unit (origin on the desk top), a floor cabinet with the monitor on top
+## and tape reels in its door, a wall unit (origin on the wall, the screen looks along +Z).
+## `variant` reshuffles the bars; `lit` off gives a dead black screen.
+
+const M := {
+	beige = preload("res://materials/vacuum_station_beige.tres"),
+	glass = preload("res://materials/vacuum_station_crt_black.tres"),
+	bar = preload("res://materials/vacuum_station_red.tres"),
+	dot = preload("res://materials/vacuum_station_amber.tres"),
+	dark = preload("res://materials/rubber.tres"),
+	iron = preload("res://materials/kit_iron.tres"),
+	tape = preload("res://materials/metal.tres"),
+}
+
+@export_enum("Desk unit", "Floor cabinet", "Wall unit") var kind := 0:
+	set(value):
+		kind = value
+		_rebuild()
+## Off: a dead screen, no bars, no glow.
+@export var lit := true:
+	set(value):
+		lit = value
+		_rebuild()
+
+
+func _build() -> void:
+	match kind:
+		0: _desk()
+		1: _cabinet()
+		2: _wall()
+
+
+## The monitor: shell, bevel ring, the glass and its bars. `base` is the shell's bottom centre.
+func _monitor(base: Vector3, w: float, h: float, d: float, tilt := 0.0) -> void:
+	var b := Basis(Vector3.RIGHT, -tilt)
+	var xf := Transform3D(b, base)
+	pm.box(M.beige, Vector3(w, h, d), xf * at(0, h * 0.5, 0))
+	pm.box(M.beige, Vector3(w * 0.92, h * 0.9, 0.05), xf * at(0, h * 0.5, d * 0.5 + 0.02))  # bevel
+	pm.box(M.glass, Vector3(w * 0.74, h * 0.66, 0.02), xf * at(0, h * 0.52, d * 0.5 + 0.05))
+	pm.box(M.dark, Vector3(w * 0.74, h * 0.08, 0.025), xf * at(0, h * 0.12, d * 0.5 + 0.04))  # the lip
+	pm.box(M.dot if lit else M.dark, Vector3(0.03, 0.03, 0.02), xf * at(w * 0.36, h * 0.12, d * 0.5 + 0.055))
+	if not lit:
+		return
+	var rng := RandomNumberGenerator.new()
+	rng.seed = variant * 7919 + kind * 131 + 17
+	var bars := 5 + variant % 3
+	var span_w := w * 0.62
+	var bw := span_w / bars * 0.62
+	var max_h := h * 0.5
+	for i in bars:
+		var bh: float = max_h * rng.randf_range(0.2, 1.0)
+		var x: float = -span_w * 0.5 + span_w * (i + 0.5) / bars
+		pm.box(M.bar, Vector3(bw, bh, 0.012), xf * at(x, h * 0.22 + bh * 0.5, d * 0.5 + 0.066))
+	pm.box(M.bar, Vector3(span_w + bw, 0.012, 0.012), xf * at(0, h * 0.215, d * 0.5 + 0.066))  # baseline
+
+
+## A keyboard slab with a dark key field, in front of the monitor on a desk.
+func _keyboard(center: Vector3) -> void:
+	pm.box(M.beige, Vector3(0.5, 0.035, 0.19), at(center.x, center.y + 0.018, center.z, Basis(Vector3.RIGHT, 0.08)))
+	pm.box(M.dark, Vector3(0.44, 0.012, 0.12), at(center.x, center.y + 0.04, center.z - 0.01, Basis(Vector3.RIGHT, 0.08)))
+
+
+## On a desk top (origin on the desk, facing +Z): the monitor on a short plinth, a keyboard.
+func _desk() -> void:
+	pm.box(M.beige, Vector3(0.36, 0.05, 0.3), at(0, 0.025, -0.08))
+	_monitor(Vector3(0, 0.05, -0.08), 0.56, 0.46, 0.5, 0.1)
+	_keyboard(Vector3(0, 0, 0.3))
+	pm.stick(M.dark, Vector3(0.1, 0.2, -0.33), Vector3(0.12, 0.0, -0.45), 0.012)  # a cable off the back
+	fp(Vector3.ZERO, Vector3.ZERO)
+
+
+## A cabinet on the floor with the monitor on top: a door with two tape reels and a row of
+## amber dots, vent slits on the side, a cable up to the monitor.
+func _cabinet() -> void:
+	span(M.beige, Vector3(-0.4, 0.06, -0.35), Vector3(0.4, 1.35, 0.35))
+	span(M.dark, Vector3(-0.38, 0, -0.33), Vector3(0.38, 0.06, 0.33))  # plinth
+	span(M.dark, Vector3(-0.34, 0.3, 0.35), Vector3(0.34, 1.25, 0.36))  # the door's dark panel
+	for x in [-0.17, 0.17]:
+		pm.cyl(M.tape, 0.12, 0.12, 0.03, at(x, 0.95, 0.37, Basis(Vector3.RIGHT, PI * 0.5)), 10)
+		pm.cyl(M.dark, 0.04, 0.04, 0.04, at(x, 0.95, 0.38, Basis(Vector3.RIGHT, PI * 0.5)), 8)
+	for i in 4:
+		var on := lit and (i + variant) % 3 != 1
+		pm.box(M.dot if on else M.dark, Vector3(0.05, 0.04, 0.015), at(-0.22 + i * 0.147, 0.5, 0.365))
+	for i in 5:  # vent slits on both sides
+		for sx in [-1.0, 1.0]:
+			pm.box(M.dark, Vector3(0.012, 0.03, 0.4), at(sx * 0.403, 0.22 + i * 0.07, -0.05))
+	_monitor(Vector3(0, 1.35, -0.02), 0.6, 0.5, 0.56, 0.12)
+	pm.stick(M.dark, Vector3(-0.2, 1.3, -0.36), Vector3(-0.25, 0.06, -0.42), 0.014)
+	fp(Vector3(0.82, 1.9, 0.72), Vector3(0, 0.95, 0))
+
+
+## On a wall (origin on the wall at the unit's centre, the screen along +Z): a boxed monitor on
+## a bracket, a small keypad under it.
+func _wall() -> void:
+	span(M.iron, Vector3(-0.32, -0.3, 0), Vector3(0.32, 0.3, 0.06))
+	_monitor(Vector3(0, -0.22, 0.06 + 0.2), 0.56, 0.44, 0.4)
+	pm.box(M.beige, Vector3(0.3, 0.1, 0.05), at(0, -0.3, 0.1))
+	for i in 3:
+		pm.box(M.dark, Vector3(0.06, 0.05, 0.012), at(-0.08 + i * 0.08, -0.3, 0.13))
+	fp(Vector3.ZERO, Vector3.ZERO)
