+	pm.box(M.plank, Vector3(W - 0.2, 0.05, 0.4), at(0.3, 0.2, -D + 0.5, Basis(Vector3.FORWARD, 0.4)))
+	pm.box(M.timber, Vector3(0.1, 2.28, 0.1), at(-0.3, 0.06, -0.4, Basis(Vector3.UP, 1.1) * Basis(Vector3.RIGHT, PI * 0.5)))
+	# The awning cloth crumpled over it all.
+	pm.box(cloth, Vector3(W + 0.2, 0.05, 1.4), at(-0.2, 0.16, -0.5, Basis(Vector3.UP, -0.2) * Basis(Vector3.RIGHT, 0.12)))
+	pm.box(cloth, Vector3(1.6, 0.04, 0.9), at(0.9, 0.3, 0.3, Basis(Vector3.UP, 0.6) * Basis(Vector3.FORWARD, -0.25)))
+	pm.cyl(M.timber, 0.16, 0.16, 0.45, at(-1.2, 0.16, 0.9, Basis(Vector3.FORWARD, PI * 0.5)), 8)  # the stool, rolled
